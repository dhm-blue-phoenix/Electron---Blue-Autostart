{
  "name": "blueautostart",
  "productName": "Blue Autostart",
  "version": "1.0.0",
  "description": "My Electron exercise application is meant for manually adding executables to the autostart. As well as managing the list includes [add, edit, delete, ....]. But only for the added elements and not for already existing ones.",
  "main": "src/app.js",
  "scripts": {
    "start": "electron-forge start",
    "build": "electron-packager . AutoLaunch --platform=win32 --arch=x64 --out=./build --overwrite --app-version=1.0.0 --build-version=100 --asar --icon=src/www/assets/resources/logo.ico --prune=true --executable-name=\"app.launch\" --win32metadata.CompanyName=\"Teal Interactive\" --win32metadata.ProductName=\"AutoLaunch\" --win32metadata.FileDescription=\"AutoLaunch\" --win32metadata.VersionString.CompanyName=\"Teal Interactive\" --win32metadata.VersionString.ProductVersion=\"1.0.0\"",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-rpm": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.4.0",
    "@electron-forge/plugin-fuses": "^7.4.0",
    "@electron/fuses": "^1.8.0",
    "electron": "^32.1.0",
    "electron-packager": "^17.1.2"
  },
  "keywords": [],
  "author": {
    "name": "BLUE"
  },
  "license": "MIT",
  "dependencies": {
    "auto-launch": "^5.0.6",
    "child_process": "^1.0.2",
    "electron-squirrel-startup": "^1.0.1",
    "fs": "^0.0.1-security",
    "glob": "^11.0.0",
    "open": "^10.1.0"
  }
}
